{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SajuMbtiPremiumReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "sections",
    "finalJudgment",
    "cover"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "mbti",
        "chart",
        "targetYear",
        "versions"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "mbti": {
          "type": "string"
        },
        "targetYear": {
          "type": "integer"
        },
        "chart": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "month",
            "day",
            "hour",
            "calculationStatus"
          ],
          "properties": {
            "year": {
              "type": "string"
            },
            "month": {
              "type": "string"
            },
            "day": {
              "type": "string"
            },
            "hour": {
              "type": [
                "string",
                "null"
              ]
            },
            "calculationStatus": {
              "type": "string",
              "enum": [
                "complete",
                "provisional"
              ]
            }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ruleset",
            "prompt",
            "schema"
          ],
          "properties": {
            "ruleset": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "schema": {
              "type": "string"
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "body",
          "keyJudgment",
          "evidence",
          "mood",
          "bodyLabels"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "saju_core",
              "mbti_contradiction",
              "decision",
              "money",
              "career",
              "relationship",
              "stress",
              "integrated_judgment",
              "year_2027",
              "year_2027_money",
              "year_2027_career",
              "year_2027_relationship"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 45
          },
          "body": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "maxItems": 4
          },
          "keyJudgment": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "mood": {
            "type": "string",
            "enum": [
              "confident",
              "reflective",
              "encouraging",
              "cautious"
            ]
          },
          "bodyLabels": {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "finalJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "closingQuestion",
        "afterClosingText",
        "headline",
        "strengths",
        "watchouts",
        "routines"
      ],
      "properties": {
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "closingQuestion": {
          "type": "string",
          "minLength": 1
        },
        "afterClosingText": {
          "type": "string",
          "maxLength": 0
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 45
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "watchouts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "routines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "action",
              "reason"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "cover": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headline",
        "description",
        "keywords"
      ],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 38
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "keywords": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
